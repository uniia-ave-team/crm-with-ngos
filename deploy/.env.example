# Шаблон конфігурації інсталяції. Скрипт ./install.sh створює .env на його
# основі та генерує секрети. При ручному налаштуванні скопіюйте файл у .env і
# заповніть значення.
#
# .env — єдиний файл, який зберігається між оновленнями. Він містить секрети:
# обмежте доступ до нього та зберігайте копію окремо від сервера.

# --- Режим -------------------------------------------------------------------
# public — сервер із публічним доменом; сертифікат від Let's Encrypt.
# local  — власне обладнання без публічного домену; локальний сертифікат.
CRM_MODE=public

# --- Адреса ------------------------------------------------------------------
# У режимі public: доменне ім'я, яке вже вказує на цей сервер.
# У режимі local: ім'я в локальній мережі або IP-адреса, наприклад
# "crm.local" або "192.168.1.20". Кілька значень — через кому.
DOMAIN=crm.example.org

# Адреса для повідомлень Let's Encrypt про сертифікат. У режимі local не
# використовується, але має бути заповнена.
ACME_EMAIL=admin@example.org

# --- Версія ------------------------------------------------------------------
# На робочій інсталяції — конкретний реліз. ./update.sh змінює значення
# автоматично.
CRM_VERSION=latest

# --- Часовий пояс ------------------------------------------------------------
TZ=Europe/Kyiv

# --- База даних --------------------------------------------------------------
POSTGRES_DB=crm
POSTGRES_USER=crm
# Генерується install.sh. Значення читається лише при першому створенні бази;
# подальша зміна потребує зміни пароля також у PostgreSQL.
POSTGRES_PASSWORD=

# --- Секрети -----------------------------------------------------------------
# Ключ підпису сесій. Генерується install.sh. Зміна ключа завершує всі сесії.
# Ключ не відновлюється з резервної копії бази.
AUTH_SIGNING_KEY=

# --- Резервні копії ----------------------------------------------------------
# Розклад у форматі cron або @daily, @weekly. Час — за TZ.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# --- Розширені налаштування --------------------------------------------------
# Додатковий compose-файл у цьому каталозі, який install.sh та update.sh
# підключають після основних. Використовується для нестандартних конфігурацій:
# зовнішня база даних, інший реверс-проксі, копії на зовнішній диск.
# Приклади — docs/deployment/own-hardware.md.
# CRM_COMPOSE_EXTRA=docker-compose.custom.yml
