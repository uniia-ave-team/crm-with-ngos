{
  "ConnectionStrings": {
    "PostgreSqlConnection": "your_connection_string_here"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "JwtOptions": {
    "Secret": "your_secret_here",
    "Issuer": "CrmApi",
    "Audience": "CrmClient",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "InvitationTokenExpiryHours": 48
  },
  "RateLimiting": {
    "WindowInSeconds": 1,
    "PermitLimit": 50,
    "QueueLimit": 0
  },
  "SerilogOptions": {
    "LogPath": "Logs",
    "AllLogsFileName": "all-.log",
    "ErrorLogsFileName": "errors-.log",
    "RetainedFileCountLimit": 5,
    "RetainedErrorFileCountLimit": 31
  },
  "IdentityOptions": {
    "RequiredLength": 8,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireUniqueEmail": true
  }
}
