<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<!-- Same as Crm.Api: the CLI reads the connection string written by `just setup`. -->
		<UserSecretsId>2d14e8c8-7049-489d-ad96-40dbd7d901f2</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="appsettings*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Crm.Application\Crm.Application.csproj" />
		<ProjectReference Include="..\Crm.Infrastructure\Crm.Infrastructure.csproj" />
	</ItemGroup>

</Project>
