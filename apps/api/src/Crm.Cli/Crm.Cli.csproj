<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<UserSecretsId>bb6d019d-e29c-46f8-b1cb-17a7ad55b2fa</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="appsettings*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Crm.Application\Crm.Application.csproj" />
		<ProjectReference Include="..\Crm.Infrastructure\Crm.Infrastructure.csproj" />
	</ItemGroup>

</Project>
