{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "LogToStandardErrorThreshold": "Error",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "ColorBehavior": "Default"
      }
    }
  },
  "ConnectionStrings": {
    "PostgreSqlConnection": "your_connection_string_here"
  },
  "IdentityOptions": {
    "RequiredLength": 8,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireUniqueEmail": true
  }
}
