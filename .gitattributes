# Normalize line endings to LF so files from Windows do not break Linux
# runners and containers.
* text=auto eol=lf

# .NET source files
*.cs            text eol=lf
*.csproj        text eol=lf
*.fsproj        text eol=lf
*.vbproj        text eol=lf
*.props         text eol=lf
*.targets       text eol=lf

*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-only tooling.
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Solution files are maintained by the IDE.
*.sln           text eol=crlf merge=union

# Generated artifacts.
package-lock.json                   linguist-generated=true -diff
packages/api-contract/openapi.json  linguist-generated=true

# Binary files.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
