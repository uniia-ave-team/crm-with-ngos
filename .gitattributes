# Нормалізація переносів рядків: файли з Windows не повинні ламати
# Linux-контейнери.
* text=auto eol=lf

# Виконуються всередині Linux-образів; CRLF неприпустимий.
*.sh            text eol=lf
*.command       text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Інструменти лише для Windows.
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Файли рішення веде IDE.
*.sln           text eol=crlf merge=union

# Згенеровані артефакти.
package-lock.json                   linguist-generated=true -diff
packages/api-contract/openapi.json  linguist-generated=true

# Бінарні файли.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
